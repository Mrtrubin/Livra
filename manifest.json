{
  "manifest_version": 3,
  "name": "Livra",
  "version": "3.0.0",
  "description": "DY智能直播助手",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "*://*.douyin.com/*",
    "*://127.0.0.1/*",
    "*://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Livra · 智能直播助手"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.douyin.com/*",
        "*://127.0.0.1/*",
        "*://localhost/*"
      ],
      "js": [
        "src/sdk/namespace.js",
        "src/sdk/types.js",
        "src/sdk/bus.js",
        "src/sdk/protocol/wire.js",
        "src/sdk/protocol/decoder.js",
        "src/sdk/room.js",
        "src/sdk/transport.js",
        "src/sdk/sender.js",
        "src/sdk/index.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.douyin.com/*",
        "*://127.0.0.1/*",
        "*://localhost/*"
      ],
      "js": [
        "src/sdk/namespace.js",
        "src/sdk/protocol/wire.js",
        "src/bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
